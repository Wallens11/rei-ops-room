{
  "name": "rei-ops-room",
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "description": "Autonomous agent ops room — Rei watches your GitHub issues, routes to the right AI runtime, and executes tasks through a real-time pixel art UI.",
  "homepage": "https://github.com/Wallens11/rei-ops-room",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wallens11/rei-ops-room.git"
  },
  "keywords": ["ai-agent", "autonomous", "claude", "codex", "github", "ops"],
  "scripts": {
    "start": "node server.mjs",
    "demo": "node demo.mjs",
    "test": "node --test tests/*.test.mjs",
    "room": "node tools/rei-cli.mjs activate room",
    "widget": "node tools/rei-cli.mjs activate widget",
    "stop": "node tools/rei-cli.mjs stop",
    "status": "node tools/rei-cli.mjs status",
    "report-only": "node tools/report-only-bridge.mjs",
    "report-only-worker": "node tools/report-only-worker.mjs",
    "report-only-service": "node tools/report-only-worker-cli.mjs",
    "execute-worker": "node tools/execute-worker.mjs",
    "execute-service": "node tools/execute-worker-cli.mjs",
    "setup": "node setup.mjs"
  }
}

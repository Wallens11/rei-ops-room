{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Rei Ops Room (Main Server)",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server.mjs"],
      "port": 4317
    },
    {
      "name": "Execute Worker (single loop)",
      "runtimeExecutable": "node",
      "runtimeArgs": ["tools/execute-worker.mjs", "--once"],
      "port": 0
    },
    {
      "name": "Execute Service (daemon)",
      "runtimeExecutable": "node",
      "runtimeArgs": ["tools/execute-worker-cli.mjs", "start"],
      "port": 0
    },
    {
      "name": "Report-Only Worker (single loop)",
      "runtimeExecutable": "node",
      "runtimeArgs": ["tools/report-only-worker.mjs"],
      "port": 0
    },
    {
      "name": "Report-Only Service (daemon)",
      "runtimeExecutable": "node",
      "runtimeArgs": ["tools/report-only-worker-cli.mjs", "start"],
      "port": 0
    }
  ]
}
